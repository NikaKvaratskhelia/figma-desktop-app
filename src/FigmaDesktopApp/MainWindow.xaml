<Window
    x:Class="FigmaDesktopApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chat="using:FigmaDesktopApp.Features.ChatStudio"
    mc:Ignorable="d"
    Title="Gemini Studio for Figma">

    <Grid Background="#0E0E13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Sleek Header -->
        <Border Grid.Row="0" Background="#14141E" Padding="20,12" BorderBrush="#222232" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#261A4D" BorderBrush="#5B38CC" BorderThickness="1">
                        <TextBlock Text="✦" FontSize="18" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gemini Studio" FontWeight="Bold" FontSize="15" Foreground="#F3F4F6"/>
                        <TextBlock Text="Native Figma Canvas Bridge" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Optional Custom API Key Pill -->
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PasswordBox x:Name="ApiKeyBox" 
                                 PlaceholderText="Custom Gemini Key (Optional)" 
                                 Width="240" 
                                 FontSize="12"
                                 CornerRadius="8"
                                 Background="#1A1A26"
                                 BorderBrush="#2C2C3E"
                                 Password="{x:Bind ViewModel.ApiKeyInput, Mode=TwoWay}"/>
                    <Button Content="Save" 
                            FontSize="12"
                            CornerRadius="8"
                            Command="{x:Bind ViewModel.SaveApiKeyCommand}"/>
                </StackPanel>

                <!-- Figma Connection Status Pill -->
                <Border Grid.Column="2" CornerRadius="20" Background="#181A24" BorderBrush="#2B2E42" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.StatusColor, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                        <TextBlock Text="•" Foreground="#4B5563" FontSize="10"/>
                        <TextBlock Text="{x:Bind ViewModel.ConnectedFileInfo, Mode=OneWay}" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Generation Progress Bar Strip -->
        <ProgressBar Grid.Row="1" 
                     IsIndeterminate="True" 
                     Height="2"
                     Foreground="#8B5CF6"
                     Background="Transparent"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>

        <!-- Chat Messages Stream -->
        <ScrollViewer Grid.Row="2" Padding="24,16" x:Name="ChatScrollViewer">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Messages}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="chat:ChatMessageItem">
                        <Grid Margin="0,0,0,20">
                            <!-- User Message Bubble (Right aligned) -->
                            <Border Visibility="{x:Bind IsUser, Mode=OneWay}"
                                    HorizontalAlignment="Right"
                                    MaxWidth="640"
                                    Background="#2E1F5E"
                                    BorderBrush="#553C9A"
                                    BorderThickness="1"
                                    CornerRadius="16,16,4,16"
                                    Padding="16,12">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <TextBlock Text="You" FontWeight="Bold" FontSize="11" Foreground="#C4B5FD"/>
                                        <TextBlock Text="{x:Bind FormattedTime}" FontSize="10" Foreground="#8B5CF6"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" Foreground="#F5F3FF" LineHeight="20"/>
                                </StackPanel>
                            </Border>

                            <!-- Assistant Studio Card (Full Width) -->
                            <Border Visibility="{x:Bind IsAssistant, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    Background="#151520"
                                    BorderBrush="#252538"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="18,16">
                                <StackPanel Spacing="10">
                                    <!-- Header: Sender, Badge, Timestamp & Copy Action -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="✦ Gemini Studio" FontWeight="Bold" FontSize="13" Foreground="#A78BFA"/>
                                            <Border CornerRadius="10" Padding="8,2" 
                                                    Background="{x:Bind StatusBadgeBackground, Mode=OneWay}"
                                                    Visibility="{x:Bind HasStatusBadge, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}" 
                                                           FontSize="11" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{x:Bind StatusBadgeForeground, Mode=OneWay}"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedTime}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Copy Figma Code Button -->
                                        <Button Grid.Column="2" 
                                                Visibility="{x:Bind HasCode, Mode=OneWay}"
                                                Click="OnCopyCodeClick"
                                                Tag="{x:Bind Code}"
                                                FontSize="11"
                                                CornerRadius="6"
                                                Background="#222234"
                                                BorderBrush="#36364E"
                                                Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="📋" FontSize="10"/>
                                                <TextBlock Text="Copy Script"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Main Assistant Response Text -->
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" 
                                               TextWrapping="Wrap" 
                                               FontSize="13.5" 
                                               Foreground="#E5E7EB" 
                                               LineHeight="22"/>

                                    <!-- Architectural Rationale / Thoughts Expander -->
                                    <Expander Header="💭 Architecture &amp; Design Thinking" 
                                              Visibility="{x:Bind HasThoughts, Mode=OneWay}"
                                              CornerRadius="8"
                                              Background="#101018"
                                              BorderBrush="#28283C"
                                              HorizontalAlignment="Stretch">
                                        <ScrollViewer MaxHeight="220" Padding="12">
                                            <TextBlock Text="{x:Bind Thoughts, Mode=OneWay}" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="#9CA3AF" 
                                                       FontSize="12" 
                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                       LineHeight="18"/>
                                        </ScrollViewer>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Prompt Bar & Suggestion Chips Container -->
        <Border Grid.Row="3" Background="#14141E" Padding="20,14" BorderBrush="#222232" BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
                <!-- Quick Suggestion Chips (Disabled when busy) -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="✦ Pricing Table (3 Tiers)" FontSize="11" CornerRadius="12" Background="#1D1D2C" BorderBrush="#2C2C40" 
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Click="OnSuggestionChipClick" Tag="Create a modern dark-mode pricing card component with 3 tiers (Starter, Pro, Enterprise) with auto-layout"/>
                        <Button Content="📊 Analytics KPI Card" FontSize="11" CornerRadius="12" Background="#1D1D2C" BorderBrush="#2C2C40" 
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Click="OnSuggestionChipClick" Tag="Design a modern analytics dashboard card showing revenue metrics, percentage increase, and a sparkline bar with auto-layout"/>
                        <Button Content="🔘 Button Variants Set" FontSize="11" CornerRadius="12" Background="#1D1D2C" BorderBrush="#2C2C40" 
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Click="OnSuggestionChipClick" Tag="Generate a modern button set featuring primary, secondary, and ghost variants in both light and dark styles"/>
                        <Button Content="📱 Mobile Profile Card" FontSize="11" CornerRadius="12" Background="#1D1D2C" BorderBrush="#2C2C40" 
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Click="OnSuggestionChipClick" Tag="Build a mobile user profile header with avatar circle, badge, follower stats, and edit profile button using auto-layout"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input Box & Generate Button -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             PlaceholderText="{x:Bind ViewModel.InputPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                             KeyDown="OnUserInputKeyDown"
                             FontSize="13.5"
                             CornerRadius="12"
                             Padding="14,10"
                             Background="#1A1A26"
                             BorderBrush="#2C2C3E"/>

                    <Button Grid.Column="1" 
                            Command="{x:Bind ViewModel.SendPromptCommand}"
                            IsEnabled="{x:Bind ViewModel.CanSendPrompt, Mode=OneWay}"
                            CornerRadius="12"
                            Padding="18,10"
                            Background="#7C3AED"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="14" Height="14" 
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Foreground="#FFFFFF"/>
                            <TextBlock Text="{x:Bind ViewModel.GenerateButtonText, Mode=OneWay}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
